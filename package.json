{
  "name": "music-dj-rent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev --proxy 5173",
    "d1:init": "wrangler d1 execute soundrent-db --local --file=./schema.sql",
    "d1:seed": "wrangler d1 execute soundrent-db --local --file=./seed.sql",
    "d1:init:remote": "wrangler d1 execute soundrent-db --remote --file=./schema.sql",
    "d1:seed:remote": "wrangler d1 execute soundrent-db --remote --file=./seed.sql",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
